{
  "name": "whale-memory",
  "version": "1.0.0",
  "description": "会淡忘、能联想、跨场合记住同一个人的长期记忆系统。零依赖，纯本地。",
  "license": "MIT",
  "type": "module",
  "main": "./src/memory-core.js",
  "exports": {
    ".": "./src/memory-core.js",
    "./lexicon": "./src/memory-lexicon.js",
    "./vector": "./src/memory-vector.js",
    "./semantic": "./src/memory-semantic.js",
    "./attention": "./src/memory-attention.js",
    "./consolidate": "./src/memory-consolidate.js",
    "./local-digest": "./src/memory-local-digest.js",
    "./self": "./src/memory-self.js",
    "./procedural": "./src/memory-procedural.js",
    "./replay": "./src/memory-replay.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "data",
    "scripts",
    "docs",
    "examples",
    "DEPLOYMENT.md",
    "FROM-SCRATCH.md",
    "USE-CASES.md",
    "README.en.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md"
  ],
  "keywords": [
    "memory",
    "long-term-memory",
    "llm",
    "chatbot",
    "companion",
    "chinese",
    "bm25",
    "lsa",
    "jieba",
    "forgetting-curve"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "demo": "node examples/demo.mjs",
    "test": "node --test tests/core.test.mjs",
    "check:lexicon": "node scripts/check-lexicon.mjs",
    "check:deps": "node scripts/check-zero-deps.mjs",
    "tick": "node scripts/memory-tick.mjs",
    "install:bridge": "node scripts/install-to-bridge.mjs",
    "install:bridge:apply": "node scripts/install-to-bridge.mjs --apply",
    "check:env": "node scripts/check-env.mjs",
    "verify": "npm run check:deps && npm run check:lexicon && npm test && npm run demo",
    "learn": "node scripts/learn-lexicon.mjs",
    "learn:apply": "node scripts/learn-lexicon.mjs --apply"
  },
  "dependencies": {},
  "repository": {
    "type": "git",
    "url": "https://github.com/yokipeek/whale-memory.git"
  },
  "author": "yokipeek",
  "homepage": "https://github.com/yokipeek/whale-memory#readme",
  "bugs": {
    "url": "https://github.com/yokipeek/whale-memory/issues"
  }
}
