  "cards": [
    {
      "dot": "cyan",
      "title": "写入：一句话怎么变成记忆",
      "items": [
        "切词器把句子拆成真词（不是碎砖头）",
        "编码门控判断值不值得记，噪声直接丢",
        "情景流水按天落盘，重要内容提炼进语义层"
      ]
    },
    {
      "dot": "emerald",
      "title": "读取：怎么想起来",
      "items": [
        "证据门槛：命中词的稀有度够不够（双尺子：库内 df × 通用词频）",
        "三路融合：BM25 字面 + n-gram/LSA 语义 + 记忆分",
        "放不下就宁可不给 —— 不硬凑条数"
      ]
    },
    {
      "dot": "amber",
      "title": "遗忘：会淡但不会消失",
      "items": [
        "幂律衰减（尾巴长，十年后仍不为零）",
        "long 跌破 0.3 降 working，working 跌破 0.06 沉冷库",
        "重复条目相似度 ≥0.95 自动合并，hits 累加"
      ]
    },
    {
      "dot": "rose",
      "title": "消化：后台怎么整理",
      "items": [
        "本地巩固先跑（零成本、永不空手），模型巩固后跑",
        "睡眠重放打乱跨天碎片找联系 → insight 槽",
        "自传体摘要 + 里程碑，让「我是谁」不靠流水"
      ]
    }
  ]
